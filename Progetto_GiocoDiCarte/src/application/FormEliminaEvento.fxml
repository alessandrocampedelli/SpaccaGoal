<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="712.0" maxWidth="1098.0"
	minHeight="712.0" minWidth="1098.0" prefHeight="712.0"
	prefWidth="1098.0" stylesheets="@application.css"
	xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.FormEliminaEventoController">
	<children>
		<ImageView fitHeight="720.0" fitWidth="1104.0"
			pickOnBounds="true">
			<image>
				<Image url="@../../img/admin1.png" />
			</image>
		</ImageView>
		<Label layoutX="120.0" layoutY="107.0" text="CODICE EVENTO">
			<font>
				<Font name="System Bold" size="18.0" />
			</font>
		</Label>
		<ListView fx:id="lblPartite" layoutX="120.0" layoutY="140.0"
			onMouseClicked="#cliccaGara" prefHeight="564.0" prefWidth="170.0"
			styleClass="comboBox" />
		<TextArea fx:id="txtInfo" editable="false" layoutX="322.0"
			layoutY="140.0" prefHeight="458.0" prefWidth="675.0"
			styleClass="comboBox" />
		<Label layoutX="322.0" layoutY="107.0" prefHeight="27.0"
			prefWidth="309.0" text="Informazioni evento selezionato">
			<font>
				<Font name="System Bold" size="18.0" />
			</font>
		</Label>
		<Button id="button_admin" fx:id="btnElimina" layoutX="508.0"
			layoutY="613.0" mnemonicParsing="false" onAction="#elimina"
			prefHeight="63.0" prefWidth="304.0" text="ELIMINA EVENTO"
			visible="false">
			<font>
				<Font name="System Bold" size="22.0" />
			</font>
		</Button>
		<ImageView fitHeight="38.0" fitWidth="58.0" layoutX="7.0"
			onMouseClicked="#tornaIndietro" pickOnBounds="true"
			preserveRatio="true">
			<image>
				<Image url="@../../img/frecciaTornaIndietro.png" />
			</image>
		</ImageView>
		<Label alignment="CENTER" layoutX="376.0" layoutY="41.0"
			prefHeight="43.0" prefWidth="346.0" text="ELIMINA EVENTO">
			<font>
				<Font name="System Bold" size="24.0" />
			</font>
		</Label>
		<ImageView fitHeight="88.0" fitWidth="88.0" layoutX="1013.0"
			layoutY="628.0" pickOnBounds="true" preserveRatio="true">
			<image>
				<Image url="@../../img/logo1.png" />
			</image>
		</ImageView>
	</children>
</AnchorPane>
