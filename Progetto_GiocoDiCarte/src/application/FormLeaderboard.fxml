<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/20"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.FormLeaderboardController">
	<children>
		<AnchorPane prefHeight="626.0" prefWidth="722.0">
			<children>
				<Label layoutX="154.0" layoutY="52.0" text="LEADERBOARD">
					<font>
						<Font size="18.0" />
					</font>
				</Label>
				<TableView fx:id="table" layoutX="154.0" layoutY="79.0"
					prefHeight="494.0" prefWidth="413.0">
					<columnResizePolicy>
						<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
					</columnResizePolicy>
				</TableView>
			</children>
		</AnchorPane>
		<ImageView fitHeight="61.0" fitWidth="59.0"
			onMouseClicked="#tornaHome">
			<image>
				<Image url="@../../backHome.png" />
			</image>
		</ImageView>
	</children>
</AnchorPane>
