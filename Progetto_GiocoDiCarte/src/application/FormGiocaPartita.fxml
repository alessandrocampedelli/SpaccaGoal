<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="712.0" maxWidth="1098.0"
	minHeight="712.0" minWidth="1098.0" prefHeight="712.0"
	prefWidth="1098.0" stylesheets="@application.css"
	xmlns="http://javafx.com/javafx/20"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.FormGiocaPartitaController">
	<children>
		<ImageView fitHeight="712.0" fitWidth="1101.0"
			pickOnBounds="true">
			<image>
				<Image url="@../../img/tavolo.jpeg" />
			</image>
		</ImageView>
		<Label fx:id="lblTurnoAttacco" layoutX="453.0" layoutY="14.0"
			text="TURNO DI ATTACCO: " textAlignment="CENTER" textFill="#0006ff">
			<font>
				<Font name="System Bold" size="22.0" />
			</font>
		</Label>
		<Label layoutX="113.0" layoutY="14.0" text="SCORE:"
			textFill="#00ff1b">
			<font>
				<Font name="System Bold" size="22.0" />
			</font>
		</Label>
		<Label fx:id="lblGiocatore1" layoutX="113.0" layoutY="54.0">
			<font>
				<Font size="22.0" />
			</font>
		</Label>
		<Label fx:id="lblGiocatore2" layoutX="113.0" layoutY="84.0">
			<font>
				<Font size="22.0" />
			</font>
		</Label>
		<Label fx:id="lblGiocatore3" layoutX="113.0" layoutY="114.0">
			<font>
				<Font size="22.0" />
			</font>
		</Label>
		<Label fx:id="lblGiocatore4" layoutX="113.0" layoutY="144.0">
			<font>
				<Font size="22.0" />
			</font>
		</Label>
		<ListView fx:id="listCarte" layoutX="119.0" layoutY="399.0"
			onMouseClicked="#selezionaCarta" orientation="HORIZONTAL"
			prefHeight="224.0" prefWidth="870.0" />
		<Button id="button_giocaCarta" fx:id="btnGiocaCarta"
			alignment="CENTER" defaultButton="true" layoutX="621.0"
			layoutY="643.0" mnemonicParsing="false" onAction="#btnGiocaCarta"
			prefHeight="56.0" prefWidth="174.0" text="GIOCA CARTA"
			visible="false">
			<font>
				<Font name="System Bold" size="18.0" />
			</font>
		</Button>
		<Button id="button_admin_logout" fx:id="btnSospendiGara"
			defaultButton="true" layoutX="814.0" layoutY="187.0"
			mnemonicParsing="false" onAction="#btnSospendiGara" prefHeight="66.0"
			prefWidth="174.0" text="SOSPENDI GARA" textAlignment="RIGHT">
			<font>
				<Font name="System Bold" size="18.0" />
			</font>
		</Button>
		<ImageView fx:id="imgGiocata" fitHeight="253.0"
			fitWidth="201.0" layoutX="454.0" layoutY="84.0" pickOnBounds="true"
			preserveRatio="true" />
		<Button id="button_passaTurno" fx:id="btnPassaTurno"
			alignment="CENTER" defaultButton="true" layoutX="301.0"
			layoutY="643.0" mnemonicParsing="false" onAction="#btnPassaTurno"
			prefHeight="56.0" prefWidth="174.0" text="PASSA TURNO"
			visible="false">
			<font>
				<Font name="System Bold" size="18.0" />
			</font>
		</Button>
		<Label fx:id="lblInfoUtente" layoutX="119.0" layoutY="372.0"
			prefHeight="20.0" prefWidth="578.0">
			<font>
				<Font name="System Bold" size="14.0" />
			</font>
		</Label>
		<ImageView fitHeight="88.0" fitWidth="88.0" layoutX="1013.0"
			layoutY="628.0" pickOnBounds="true" preserveRatio="true">
			<image>
				<Image url="@../../img/logo1.png" />
			</image>
		</ImageView>
	</children>
</AnchorPane>
